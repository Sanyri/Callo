# Server-side secrets. Configure with `wrangler secret put ...` in production.
CALLO_SECRET=generate-a-long-random-secret
# Optional for WebRTC relay. Keep private.
TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_USERNAME=example-user
TURN_CREDENTIAL=example-password
# Optional deployment metadata
APP_ORIGIN=https://callo.example.com
